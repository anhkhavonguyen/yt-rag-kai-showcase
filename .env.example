# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider Configuration
# Choose your AI provider: "openai" or "anthropic"
AI_PROVIDER=anthropic

# OpenAI Configuration (using compatible models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Anthropic Configuration (using latest models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Optional: any OpenAI-compatible endpoint for chat + embeddings.
# Leave empty to use api.openai.com.
OPENAI_BASE_URL=

# --- Free: Google Gemini (OpenAI-compatible) -------------------------------
# Uncomment to use Gemini's free tier instead of OpenAI. OPENAI_API_KEY then
# holds your Gemini API key (https://aistudio.google.com). Free-tier prompts
# and documents may be used by Google to improve its products.
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_CHAT_MODEL=gemini-3.5-flash
# OPENAI_EMBED_MODEL=gemini-embedding-2
# EMBEDDING_SEND_DIMENSIONS=true
# EMBEDDING_BATCH_SIZE=100
# After switching the embedding model, re-seed all documents: vectors from
# different models can't be compared.

# Embedding size stored in Supabase; must match VECTOR(1536) in
# sql/init_supabase.sql. Longer vectors from the model are shortened and
# re-normalized automatically.
EMBEDDING_DIMENSIONS=1536

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin token for POST /seed. When set, /seed requires the header
#   Authorization: Bearer <SEED_TOKEN>
# (the chat page asks for it; chatbot.py reads SEED_TOKEN from its environment).
# Leave empty for local development. On Render it's generated for you.
SEED_TOKEN=
