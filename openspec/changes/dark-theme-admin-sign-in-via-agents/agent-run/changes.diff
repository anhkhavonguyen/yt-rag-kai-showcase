+/*
+ * The one shared stylesheet of every page: a single dark palette.
+ * Pages take every color from these tokens and define none of their own.
+ *
+ * Contrast (WCAG AA, checked by tests/test_theme.py):
+ * - at least 4.5:1 for --text, --text-muted, --danger and --success on --bg and --surface,
+ *   for --text and --text-muted on --surface-raised, and for --on-accent on --accent;
+ * - at least 3:1 for --accent and --focus on --bg, and for --focus on --surface.
+ */
+:root {
+    color-scheme: dark;
+    --bg: #0f1117;
+    --surface: #181b23;
+    --surface-raised: #222632;
+    --text: #e7e9ee;
+    --text-muted: #a4abba;
+    --accent: #8b93ff;
+    --on-accent: #0f1117;
+    --border: #3a4050;
+    --danger: #ff8a8a;
+    --success: #5fd4a0;
+    --focus: #ffd166;
+}
+
+body {
+    margin: 0;
+    background: var(--bg);
+    color: var(--text);
+    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+}
+
+a {
+    color: var(--accent);
+}
+
+input,
+textarea,
+select {
+    background: var(--surface-raised);
+    color: var(--text);
+    border: 1px solid var(--border);
+    font: inherit;
+}
+
+input::placeholder,
+textarea::placeholder {
+    color: var(--text-muted);
+    opacity: 1;
+}
+
+button {
+    font: inherit;
+}
+
+/* Primary buttons */
+.button-primary {
+    background: var(--accent);
+    color: var(--on-accent);
+    border: 1px solid var(--accent);
+    border-radius: 8px;
+    padding: 10px 16px;
+    font-weight: 600;
+    cursor: pointer;
+}
+
+.button-primary:hover {
+    filter: brightness(1.1);
+}
+
+.button-primary:disabled {
+    background: var(--surface-raised);
+    border-color: var(--border);
+    color: var(--text-muted);
+    cursor: not-allowed;
+    filter: none;
+}
+
+/* Secondary buttons, such as "Sign out" */
+.button-secondary {
+    background: transparent;
+    color: var(--text);
+    border: 1px solid var(--border);
+    border-radius: 8px;
+    padding: 8px 14px;
+    cursor: pointer;
+}
+
+.button-secondary:hover {
+    background: var(--surface-raised);
+}
+
+.button-secondary:disabled {
+    color: var(--text-muted);
+    cursor: not-allowed;
+}
+
+/* Error and success messages */
+.text-error {
+    color: var(--danger);
+}
+
+.text-success {
+    color: var(--success);
+}
+
+[hidden] {
+    display: none !important;
+}
+
+/* Keyboard focus is always visible */
+:focus-visible {
+    outline: 2px solid var(--focus);
+    outline-offset: 2px;
+}
