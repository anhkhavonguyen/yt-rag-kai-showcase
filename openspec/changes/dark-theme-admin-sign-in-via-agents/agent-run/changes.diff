+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <meta name="color-scheme" content="dark">
+    <title>Admin sign in</title>
+    <link rel="stylesheet" href="/static/theme.css">
+    <style>
+        * {
+            box-sizing: border-box;
+        }
+
+        body {
+            min-height: 100vh;
+            display: flex;
+            padding: 20px;
+        }
+
+        /* Centered; margin: auto keeps the card reachable on short screens. */
+        .sign-in-card {
+            width: 100%;
+            max-width: 400px;
+            margin: auto;
+            padding: 28px 24px;
+            background: var(--surface);
+            border: 1px solid var(--border);
+            border-radius: 16px;
+            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
+        }
+
+        .sign-in-card h1 {
+            margin: 0 0 8px;
+            font-size: 20px;
+            font-weight: 600;
+        }
+
+        .intro {
+            margin: 0 0 20px;
+            color: var(--text-muted);
+            font-size: 14px;
+            line-height: 1.5;
+        }
+
+        .sign-in-form {
+            display: flex;
+            flex-direction: column;
+            gap: 10px;
+        }
+
+        .sign-in-form label {
+            font-size: 14px;
+            font-weight: 500;
+        }
+
+        .sign-in-form input {
+            width: 100%;
+            padding: 12px 14px;
+            border-width: 2px;
+            border-radius: 8px;
+            font-size: 16px;
+            transition: border-color 0.2s ease;
+        }
+
+        .sign-in-form input:focus {
+            border-color: var(--accent);
+        }
+
+        .sign-in-form button {
+            padding: 12px 16px;
+            font-size: 15px;
+        }
+
+        .form-message {
+            min-height: 1.5em;
+            margin: 0;
+            font-size: 14px;
+            font-weight: 500;
+        }
+
+        .back-link {
+            display: inline-block;
+            margin-top: 12px;
+            font-size: 14px;
+            font-weight: 500;
+            text-decoration: none;
+        }
+
+        .back-link:hover {
+            text-decoration: underline;
+        }
+    </style>
+</head>
+<body>
+    <main class="sign-in-card">
+        <h1>Admin sign in</h1>
+        <p class="intro" id="intro">Enter this deployment's admin token (SEED_TOKEN) to manage the knowledge base.</p>
+        <form class="sign-in-form" id="signInForm" novalidate>
+            <label for="tokenInput">Admin token</label>
+            <input id="tokenInput" type="password" autocomplete="current-password" aria-describedby="intro" autofocus>
+            <button type="submit" class="button-primary" id="signInBtn">Sign in</button>
+            <p id="message" class="form-message text-error" role="alert"></p>
+        </form>
+        <a class="back-link" href="/chat">← Back to Customer Support</a>
+    </main>
+
+    <script>
+        const signInForm = document.getElementById('signInForm');
+        const tokenInput = document.getElementById('tokenInput');
+        const signInBtn = document.getElementById('signInBtn');
+        const message = document.getElementById('message');
+
+        // POST /admin/login answers 204 with the session cookie for the right token,
+        // and 401 for any other. The token is sent once and kept nowhere in the page.
+        signInForm.addEventListener('submit', async function(e) {
+            e.preventDefault();
+            const token = tokenInput.value.trim();
+            if (!token) {
+                message.textContent = 'Enter the admin token';
+                tokenInput.focus();
+                return;
+            }
+
+            signInBtn.disabled = true;
+            message.textContent = '';
+            try {
+                const response = await fetch('/admin/login', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ token })
+                });
+                if (response.status === 204) {
+                    location.replace('/admin');
+                    return; // the button stays disabled while the editor opens
+                }
+                if (response.status === 401) {
+                    message.textContent = 'Admin token rejected';
+                    tokenInput.select();
+                } else {
+                    message.textContent = "Can't sign in right now. Please try again.";
+                    tokenInput.focus();
+                }
+            } catch (error) {
+                message.textContent = "Can't reach the server";
+                tokenInput.focus();
+            }
+            signInBtn.disabled = false;
+        });
+    </script>
+</body>
+</html>
